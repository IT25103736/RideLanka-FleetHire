<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<c:set var="pageTitle" value="Fleet & Maintenance" scope="request"/><c:set var="sectionName" value="Fleet Operations" scope="request"/><c:set var="activePage" value="fleet" scope="request"/>
<%@ include file="/WEB-INF/views/common/header.jsp" %>
<style>
.fm-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:20px}.fm-card{background:var(--glass-bg);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--glass-border);border-radius:var(--r-shell);box-shadow:var(--glass-shadow);padding:22px}.fm-card h3{color:#fff;font-size:15px;margin:0 0 14px}.fm-card p{font-size:12px;color:rgba(255,255,255,.55);line-height:1.6}.fm-f{display:flex;flex-direction:column;gap:7px;margin-bottom:12px}.fm-f label{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.55);font-weight:700}.fm-f input,.fm-f select,.fm-f textarea{width:100%;box-sizing:border-box;background:rgba(255,255,255,.04);border:1px solid var(--glass-border);border-radius:10px;color:#fff;padding:10px 12px}.fm-f select option{background:#17221f;color:#fff}.fm-f textarea{min-height:72px;resize:vertical}.fm-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px}.fm-stat{background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:16px;padding:18px}.fm-stat span{display:block}.fm-label{font-size:10px;text-transform:uppercase;letter-spacing:.13em;color:rgba(255,255,255,.5)}.fm-val{font-size:25px;font-weight:700;color:#fff;margin-top:4px}.fm-table{width:100%;border-collapse:collapse}.fm-table th{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:rgba(255,255,255,.5);text-align:left;padding:12px 14px;border-bottom:1px solid var(--glass-border)}.fm-table td{font-size:12px;color:rgba(255,255,255,.78);padding:12px 14px;border-bottom:1px solid rgba(255,255,255,.05)}.fm-b{display:inline-block;font-size:10px;font-weight:700;padding:4px 8px;border-radius:999px;border:1px solid}.s-ok{color:#6fcca3;border-color:rgba(111,204,163,.28);background:rgba(111,204,163,.08)}.s-w{color:#fbbf24;border-color:rgba(251,191,36,.28);background:rgba(251,191,36,.08)}.s-b{color:#f87171;border-color:rgba(248,113,113,.28);background:rgba(248,113,113,.08)}@media(max-width:850px){.fm-grid{grid-template-columns:1fr}.fm-stats{grid-template-columns:1fr 1fr}}
</style>
<div class="page-header-row"><div class="page-header" style="margin-bottom:0"><span class="eyebrow">Dananjaya • Fleet / Maintenance</span><h1>Operational <em>fleet control.</em></h1><p>This module controls vehicle readiness, maintenance work and inspections. It does not create or edit master vehicle details.</p></div><c:if test="${sessionScope.loggedUser.role == 'ADMIN' || sessionScope.loggedUser.role == 'VEHICLE'}"><a class="btn btn-secondary" href="${pageContext.request.contextPath}/vehicle?action=list">Vehicle master records</a></c:if></div>
<c:if test="${param.msg=='status'}"><div class="fm-b s-ok" style="margin:14px 0">Vehicle operational status updated.</div></c:if><c:if test="${param.msg=='scheduled'}"><div class="fm-b s-ok" style="margin:14px 0">Maintenance scheduled.</div></c:if><c:if test="${param.msg=='inspection'}"><div class="fm-b s-ok" style="margin:14px 0">Inspection recorded.</div></c:if><c:if test="${param.error != null}"><div class="fm-b s-b" style="margin:14px 0">${param.error}</div></c:if>
<div class="fm-stats"><div class="fm-stat"><span class="fm-label">Available</span><span class="fm-val">${availableCount}</span></div><div class="fm-stat"><span class="fm-label">Maintenance</span><span class="fm-val">${maintenanceCount}</span></div><div class="fm-stat"><span class="fm-label">Out of service</span><span class="fm-val">${outCount}</span></div><div class="fm-stat"><span class="fm-label">Scheduled jobs</span><span class="fm-val">${scheduledCount}</span></div></div>
<div class="fm-grid"><div class="fm-card"><h3>Change operational status</h3><p>Maintenance staff can immediately mark a car as maintenance or out of service without changing the vehicle master record.</p><form action="${pageContext.request.contextPath}/fleet/operational-status" method="post"><div class="fm-f"><label>Vehicle</label><select name="vehicleId" required><c:forEach var="v" items="${vehicles}"><option value="${v.vehicleId}">${v.vehicleId} • ${v.make} ${v.model} • ${v.branchName}</option></c:forEach></select></div><div class="fm-f"><label>Status</label><select name="status" required><option value="AVAILABLE">Available</option><option value="RESERVED">Reserved</option><option value="RENTED">Rented</option><option value="MAINTENANCE">Maintenance</option><option value="OUT_OF_SERVICE">Out of Service</option></select></div><button class="btn btn-primary" type="submit">Update operational status</button></form></div>
<div class="fm-card"><h3>Schedule service / repair</h3><p>Record service work separately from the vehicle master data.</p><form action="${pageContext.request.contextPath}/fleet/schedule" method="post"><div class="fm-f"><label>Vehicle</label><select name="vehicleId"><c:forEach var="v" items="${vehicles}"><option value="${v.vehicleId}">${v.vehicleId} • ${v.make} ${v.model}</option></c:forEach></select></div><div class="fm-f"><label>Maintenance type</label><select name="maintenanceType"><option value="SERVICE">Service</option><option value="REPAIR">Repair</option><option value="INSPECTION">Inspection</option><option value="OTHER">Other</option></select></div><div class="fm-f"><label>Scheduled date</label><input type="date" name="scheduledDate" required/></div><div class="fm-f"><label>Technician</label><input name="technician" required placeholder="Workshop / technician"/></div><div class="fm-f"><label>Cost (LKR)</label><input type="number" name="cost" min="0" step="100" value="0"/></div><div class="fm-f"><label>Description</label><textarea name="description" placeholder="Routine service, brake repair..."></textarea></div><button class="btn btn-primary" type="submit">Schedule maintenance</button></form></div></div>
<div class="fm-card"><h3>Maintenance records</h3><div style="overflow:auto"><table class="fm-table"><thead><tr><th>ID</th><th>Vehicle</th><th>Type</th><th>Date</th><th>Technician</th><th>Cost</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach var="m" items="${maintenanceRecords}"><tr><td>${m.maintenanceId}</td><td>${m.vehicleId}</td><td>${m.maintenanceType}</td><td>${m.scheduledDate}</td><td>${m.technician}</td><td>${m.cost}</td><td><span class="fm-b ${m.status=='COMPLETED'?'s-ok':m.status=='CANCELLED'?'s-b':'s-w'}">${m.status}</span></td><td><form action="${pageContext.request.contextPath}/fleet/status" method="post"><input type="hidden" name="maintenanceId" value="${m.maintenanceId}"/><c:if test="${m.status=='SCHEDULED'}"><button class="btn btn-ghost btn-sm" name="status" value="IN_PROGRESS">Start</button></c:if><c:if test="${m.status=='IN_PROGRESS'}"><button class="btn btn-primary btn-sm" name="status" value="COMPLETED">Complete</button></c:if><c:if test="${m.status!='COMPLETED' && m.status!='CANCELLED'}"><button class="btn btn-ghost btn-sm" name="status" value="CANCELLED">Cancel</button></c:if></form></td></tr></c:forEach></tbody></table></div></div>
<div class="fm-grid" style="margin-top:18px"><div class="fm-card"><h3>Record inspection</h3><form action="${pageContext.request.contextPath}/fleet/inspection" method="post"><div class="fm-f"><label>Vehicle</label><select name="vehicleId"><c:forEach var="v" items="${vehicles}"><option value="${v.vehicleId}">${v.vehicleId} • ${v.make} ${v.model}</option></c:forEach></select></div><div class="fm-f"><label>Maintenance ID (optional)</label><input name="maintenanceId" placeholder="e.g. MT001"/></div><div class="fm-f"><label>Result</label><select name="result"><option value="PASS">Pass</option><option value="FAIL">Fail</option></select></div><div class="fm-f"><label>Notes</label><textarea name="notes"></textarea></div><button class="btn btn-primary" type="submit">Save inspection</button></form></div><div class="fm-card"><h3>Recent inspections</h3><table class="fm-table"><thead><tr><th>Vehicle</th><th>Date</th><th>Result</th><th>Notes</th></tr></thead><tbody><c:forEach var="i" items="${inspections}"><tr><td>${i.vehicleId}</td><td>${i.inspectionDate}</td><td><span class="fm-b ${i.result=='PASS'?'s-ok':'s-b'}">${i.result}</span></td><td>${i.notes}</td></tr></c:forEach></tbody></table></div></div>
<%@ include file="/WEB-INF/views/common/footer.jsp" %>
