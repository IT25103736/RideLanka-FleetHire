<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<c:set var="pageTitle" value="Vehicle Management" scope="request"/><c:set var="sectionName" value="Vehicle Master" scope="request"/><c:set var="activePage" value="vehicles" scope="request"/>
<%@ include file="/WEB-INF/views/common/header.jsp" %>
<style>
.vl-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:20px}.vl-card{background:var(--glass-bg);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--glass-border);border-radius:var(--r-shell);box-shadow:var(--glass-shadow);overflow:hidden;margin-bottom:20px}.vl-stat{padding:18px 20px}.vl-label{display:block;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.55)}.vl-val{display:block;font-size:25px;color:#fff;font-weight:700;margin-top:5px}.vl-head{padding:18px 22px;border-bottom:1px solid var(--glass-border);display:flex;justify-content:space-between;align-items:center}.vl-table{width:100%;border-collapse:collapse}.vl-table th{padding:12px 18px;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:rgba(255,255,255,.5);border-bottom:1px solid var(--glass-border)}.vl-table td{padding:13px 18px;border-bottom:1px solid rgba(255,255,255,.05);color:rgba(255,255,255,.8);font-size:13px}.vl-b{display:inline-flex;padding:4px 9px;border-radius:999px;border:1px solid;font-size:10px;font-weight:700}.ok{color:#6fcca3;border-color:rgba(111,204,163,.3);background:rgba(111,204,163,.08)}.warn{color:#fbbf24;border-color:rgba(251,191,36,.3);background:rgba(251,191,36,.08)}.bad{color:#f87171;border-color:rgba(248,113,113,.3);background:rgba(248,113,113,.08)}.act{display:inline-flex;gap:6px;justify-content:flex-end;width:100%}.empty{padding:50px;text-align:center;color:rgba(255,255,255,.55)}@media(max-width:900px){.vl-stats{grid-template-columns:1fr 1fr}.vl-table{min-width:1000px}.vl-card{overflow:auto}}@media(max-width:560px){.vl-stats{grid-template-columns:1fr}}
</style>
<div class="page-header-row reveal"><div class="page-header" style="margin-bottom:0"><span class="eyebrow">Jayawardana • Vehicle Management</span><h1>Vehicle <em>master records.</em></h1><p>Create, update and remove the vehicle's identity/specification data. Fleet status is managed separately.</p></div><a href="${pageContext.request.contextPath}/vehicle?action=add" class="btn btn-primary"><i class="ti ti-plus"></i> Add vehicle</a></div>
<c:if test="${param.msg == 'saved'}"><div class="vl-b ok" style="margin-bottom:14px">Vehicle saved successfully.</div></c:if><c:if test="${param.msg == 'deleted'}"><div class="vl-b ok" style="margin-bottom:14px">Vehicle deleted.</div></c:if><c:if test="${param.error != null}"><div class="vl-b bad" style="margin-bottom:14px">${param.error}</div></c:if><c:if test="${not empty errorMessage}"><div class="vl-b bad" style="margin-bottom:14px">${errorMessage}</div></c:if>
<div class="vl-stats"><div class="vl-card vl-stat"><span class="vl-label">Total vehicles</span><span class="vl-val">${totalVehicles}</span></div><div class="vl-card vl-stat"><span class="vl-label">Available</span><span class="vl-val">${availableVehicles}</span></div><div class="vl-card vl-stat"><span class="vl-label">In maintenance</span><span class="vl-val">${maintenanceVehicles}</span></div><div class="vl-card vl-stat"><span class="vl-label">Out of service</span><span class="vl-val">${outVehicles}</span></div></div>
<div class="vl-card"><div class="vl-head"><strong style="color:#fff">Vehicle inventory</strong><span style="font-size:11px;color:rgba(255,255,255,.55)">MSSQL • dbo.vehicles</span></div><c:choose><c:when test="${not empty vehicles}"><table class="vl-table"><thead><tr><th>ID</th><th>Vehicle</th><th>Plate</th><th>Specs</th><th>Category</th><th>Branch</th><th>Daily rate</th><th>Operational status</th><th>Actions</th></tr></thead><tbody><c:forEach var="v" items="${vehicles}"><tr><td>${v.vehicleId}</td><td><strong style="color:#fff">${v.make} ${v.model}</strong><br><span style="font-size:11px;color:rgba(255,255,255,.45)">${v.vehicleType} • ${v.vehicleYear}</span></td><td>${v.plateNo}</td><td>${v.transmission} • ${v.fuelType} • ${v.seats} seats • ${v.mileage} km</td><td>${v.categoryName}</td><td>${v.branchName}</td><td><fmt:formatNumber value="${v.dailyRate}" pattern="#,##0.00"/> LKR</td><td><c:choose><c:when test="${v.status=='AVAILABLE'}"><span class="vl-b ok">AVAILABLE</span></c:when><c:when test="${v.status=='MAINTENANCE'}"><span class="vl-b warn">MAINTENANCE</span></c:when><c:when test="${v.status=='OUT_OF_SERVICE'}"><span class="vl-b bad">OUT OF SERVICE</span></c:when><c:otherwise><span class="vl-b warn">${v.status}</span></c:otherwise></c:choose></td><td><div class="act"><a class="btn btn-ghost btn-sm" href="${pageContext.request.contextPath}/vehicle?action=edit&id=${v.vehicleId}">Edit</a><a class="btn btn-ghost btn-sm" target="_blank" href="${pageContext.request.contextPath}/vehicle?action=view&id=${v.vehicleId}">View</a><a class="btn btn-ghost btn-sm" href="${pageContext.request.contextPath}/vehicle?action=delete&id=${v.vehicleId}" onclick="return confirm('Delete ${v.vehicleId}?');">Delete</a></div></td></tr></c:forEach></tbody></table></c:when><c:otherwise><div class="empty">No vehicles found in the MSSQL vehicle master.</div></c:otherwise></c:choose></div>
<div style="text-align:center;color:rgba(255,255,255,.5);font-size:12px;margin:10px 0 30px">Need to change availability, maintenance or out-of-service status? Use <a style="color:var(--bx-primary)" href="${pageContext.request.contextPath}/fleet">Fleet &amp; Maintenance</a>.</div>
<%@ include file="/WEB-INF/views/common/footer.jsp" %>
